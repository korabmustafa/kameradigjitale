PORT=4000

DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/kameradigjitale?schema=public

# Optional order-confirmation email delivery.
# If SMTP_HOST is empty/missing, backend should only log email previews.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_MS=10000
SMTP_USER=your_mailtrap_smtp_user
SMTP_PASS=your_mailtrap_smtp_password
SMTP_FROM=orders@kameradigjitale.com

FRONTEND_URL=http://localhost:5173

# Admin dashboard authentication.
ADMIN_PASSWORD="change-me"
ADMIN_AUTH_TOKEN="replace-with-a-long-random-token"
